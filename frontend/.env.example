# Vite
# API origin. Leave empty for same origin: the dev server, nginx or the Worker forward /api.
# Set a full origin (https://api.example.com) only if the API lives on another domain.
VITE_API_BASE=

# Google
VITE_GOOGLE_CLIENT_ID=

# Dev server only: where it forwards /api (the backend). In Docker, docker-compose.yml sets it.
DEV_API_PROXY_TARGET=
