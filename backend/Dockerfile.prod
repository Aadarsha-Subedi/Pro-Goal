# Production image: no dev dependencies, no .env (variables are injected at runtime).
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# libpq is required by psycopg
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /usr/local/bin/uv

WORKDIR /app

# Dependencies first so this layer is cached until the lockfile changes
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .

# COPY keeps host file modes (settings.py is 600 locally), so make sources
# readable by the non-root runtime user.
# settings.py creates .celery/ at import time, so the runtime user must own it
RUN useradd --system --create-home app \
    && chmod -R a+rX /app \
    && mkdir -p /app/.celery \
    && chown -R app:app /app/.celery
USER app

EXPOSE 8080
CMD ["bash", "/app/start-prod.sh"]
