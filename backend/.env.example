# Every variable below is required: settings.py fails at startup if one is missing.
# An empty value is allowed where noted.

# Database settings
PROJECT_MANAGEMENT_DB_CONTAINER_NAME=pro-goal-db
PROJECT_MANAGEMENT_DB_NAME=
PROJECT_MANAGEMENT_DB_USER=
PROJECT_MANAGEMENT_DB_PASSWORD=
PROJECT_MANAGEMENT_DB_HOST=
PROJECT_MANAGEMENT_DB_PORT=
# disable locally (Docker Postgres), require for hosted Postgres such as Neon
PROJECT_MANAGEMENT_DB_SSLMODE=disable
# Tests without Docker: use SQLite instead of Postgres (true/false)
PROJECT_MANAGEMENT_USE_SQLITE=false

# Redis settings (cache, sessions, Celery broker)
PROJECT_MANAGEMENT_REDIS_CONTAINER_NAME=pro-goal-redis
# Host port published by docker-compose.yml (local Redis only)
PROJECT_MANAGEMENT_REDIS_PORT=6379
# Full URL: redis://localhost:6379/0 locally, rediss://default:<password>@<host>:6379
# on hosted Redis such as Upstash. Always database 0.
PROJECT_MANAGEMENT_REDIS_URL=redis://localhost:6379/0

# Django
PROJECT_MANAGEMENT_SECRET_KEY=
PROJECT_MANAGEMENT_DEBUG=true
PROJECT_MANAGEMENT_ALLOWED_HOSTS=localhost,127.0.0.1
PROJECT_MANAGEMENT_FRONTEND_URL=http://localhost:3000
PROJECT_MANAGEMENT_CORS_ALLOWED_ORIGINS=http://localhost:3000
PROJECT_MANAGEMENT_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Share cookies between app.example.com and api.example.com (empty = host-only cookies)
PROJECT_MANAGEMENT_COOKIE_DOMAIN=
# false locally (plain HTTP), true in production
PROJECT_MANAGEMENT_SECURE_COOKIES=false
PROJECT_MANAGEMENT_SSL_REDIRECT=false
# Number of our own proxies in front of Django (0 locally, 1 or 2 in production)
PROJECT_MANAGEMENT_NUM_PROXIES=0

# Email
PROJECT_MANAGEMENT_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PROJECT_MANAGEMENT_DEFAULT_FROM_EMAIL=no-reply@localhost
# SMTP (only used with django.core.mail.backends.smtp.EmailBackend; empty otherwise)
PROJECT_MANAGEMENT_EMAIL_HOST=
PROJECT_MANAGEMENT_EMAIL_PORT=
PROJECT_MANAGEMENT_EMAIL_HOST_USER=
PROJECT_MANAGEMENT_EMAIL_HOST_PASSWORD=
PROJECT_MANAGEMENT_EMAIL_USE_TLS=false

# Google sign-in: OAuth client id used to validate ID tokens (empty = disabled)
PROJECT_MANAGEMENT_GOOGLE_CLIENT_ID=

# Avatar storage: Cloudflare R2. Leave the bucket empty to store files under media/.
PROJECT_MANAGEMENT_R2_ENDPOINT_URL=
PROJECT_MANAGEMENT_R2_ACCESS_KEY_ID=
PROJECT_MANAGEMENT_R2_SECRET_ACCESS_KEY=
PROJECT_MANAGEMENT_R2_BUCKET_NAME=
PROJECT_MANAGEMENT_R2_PUBLIC_BASE_URL=

# Sentry: DSN from Project Settings > Client Keys (empty = Sentry disabled)
PROJECT_MANAGEMENT_SENTRY_DSN=

# local or prod. Also the environment name in Sentry events. In prod, signups and
# email changes with disposable addresses (yopmail, mailinator, ...) are refused.
PROJECT_MANAGEMENT_ENVIRONMENT=local

# Local development only: use relaxed throttle rates (login 500/min instead of 5/min).
# Leave false in staging and production.
PROJECT_MANAGEMENT_RELAX_THROTTLES=false

# Integrations (Slack). Empty values keep integrations switched off.
# Public HTTPS address Slack uses to reach this API: the tunnel URL in development
# (for example https://my-dev.ngrok-free.app), the real domain in production.
# Add its host to PROJECT_MANAGEMENT_ALLOWED_HOSTS too.
PROJECT_MANAGEMENT_PUBLIC_API_URL=
# Fernet keys for encrypting provider tokens, comma separated (first one encrypts,
# all decrypt, so a new key can be added in front to rotate). Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROJECT_MANAGEMENT_INTEGRATION_ENCRYPTION_KEYS=
# From the Slack app: Basic Information > App Credentials
PROJECT_MANAGEMENT_SLACK_CLIENT_ID=
PROJECT_MANAGEMENT_SLACK_CLIENT_SECRET=
PROJECT_MANAGEMENT_SLACK_SIGNING_SECRET=
